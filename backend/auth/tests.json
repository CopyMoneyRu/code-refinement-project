{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Me without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "me"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true,
        "user": null
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "nope"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "ok": false,
        "error": "unknown_action"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Register validation",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "register",
        "name": "A",
        "email": "bad",
        "password": "1"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Login unknown user",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login",
        "email": "nobody@example.com",
        "password": "wrongpass1"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false,
        "error": "invalid_credentials"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Verify bad code",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "verify",
        "email": "nobody@example.com",
        "code": "000000"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "ok": false,
        "error": "invalid_code"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_users"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete user without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_delete_user",
        "userId": 1
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Set role without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_set_role",
        "userId": 1,
        "role": "admin",
        "permissions": [
          "users"
        ]
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "OAuth without bridge secret",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "oauth_login",
        "provider": "google",
        "providerUserId": "1",
        "email": "a@b.cd"
      },
      "expectedStatus": 403,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    }
  ]
}