{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Public course list",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "list"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Course by slug",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "get",
        "slug": "osnovy-investiciy"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown course",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "get",
        "slug": "no-such-course"
      },
      "expectedStatus": 404,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Save without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "save",
        "title": "Test"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Upload without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "upload_cover"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Save author without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "save_author",
        "name": "Тест"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin authors without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_authors"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Author page",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "author",
        "slug": "invest"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown author",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "author",
        "slug": "no-such-author"
      },
      "expectedStatus": 404,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "delete_course without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete_course",
        "id": 1
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "delete_author without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "delete_author",
        "id": 1
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "set_author_published without session",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "set_author_published",
        "id": 1
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    }
  ]
}