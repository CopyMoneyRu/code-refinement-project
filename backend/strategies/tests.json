{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Public catalog",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "catalog"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Detail requires login",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "get",
        "slug": "x"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false,
        "error": "unauthorized"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin requires login",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "admin_list"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Offer requires login",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "offer",
        "slug": "x"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Finance requires login",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "finance"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Robokassa result without params",
      "method": "POST",
      "path": "/?action=robokassa_result",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Cron without key",
      "method": "POST",
      "path": "/?action=cron_renewals",
      "body": {},
      "expectedStatus": 403
    }
  ]
}